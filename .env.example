# ==============================================================================
# VentureIQ Live AI Inference Configuration (Optional)
# Leave blank to use High-Precision Rule-Based & ML Offline Analysis.
#
# Option 1 (Recommended - 100% Free & High Speed):
# 1. Get a free API key at: https://console.groq.com/keys
# 2. Paste it below as GROQ_API_KEY=gsk_...
#
# Option 2 (OpenRouter):
# 1. Get a key at: https://openrouter.ai/keys
# 2. Paste it below as OPENROUTER_API_KEY=sk-or-v1-...
# ==============================================================================
GROQ_API_KEY=
OPENROUTER_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Platform Settings
VENTUREIQ_SEMANTIC=auto
VENTUREIQ_TOP_K=5
VENTUREIQ_CHUNK_WORDS=300
VENTUREIQ_CHUNK_OVERLAP=60
VENTUREIQ_DB_PATH=data/ventureiq_history.sqlite3
VENTUREIQ_LOG_LEVEL=INFO
